rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow test connection
    match /test/connection {
      allow get: if true;
    }

    // --- Global Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Role Helpers (No custom claims, lookup in DB) ---
    function getUser(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }
    function hasRole(role) {
      return isSignedIn() && getUser(request.auth.uid).role == role;
    }
    function isAdmin() { 
      return isSignedIn() 
        && (
          (request.auth.token.get('email', "").lower() == "bolajiogidan@gmail.com") ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
        );
    }
    function isTechnician() { 
      return isSignedIn() 
        && (
          isAdmin() ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "technician")
        );
    }

    // --- Entity Validation Blueprints ---

    function isValidUser(data) {
      return data.keys().hasAll(['name', 'email', 'role', 'department']) 
          && data.keys().size() <= 5
          && data.name is string && data.name.size() > 0 && data.name.size() <= 100
          && data.email is string && data.email.size() > 0 && data.email.size() <= 100
          && data.role in ['admin', 'technician', 'student']
          && data.department is string && data.department.size() <= 100;
    }

    function isValidAsset(data) {
      return data.keys().hasAll(['name', 'category', 'serialNumber', 'status', 'quantity', 'location', 'description', 'createdAt', 'updatedAt'])
          && data.keys().size() <= 11 // Allowing for optional fields like imageUrl, threshold
          && data.name is string && data.name.size() > 0 && data.name.size() <= 200
          && data.category is string && data.category.size() > 0 && data.category.size() <= 100
          && data.serialNumber is string && data.serialNumber.size() <= 100
          && data.status in ['Available', 'In-Use', 'Broken', 'Low-Stock']
          && data.quantity is int && data.quantity >= 0
          && data.location is string && data.location.size() > 0 && data.location.size() <= 100
          && data.description is string && data.description.size() <= 1000
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['assetId', 'assetName', 'userId', 'userName', 'checkoutDate', 'expectedReturnDate', 'status'])
          && data.keys().size() <= 8 // Allowing for optional returnDate
          && data.assetId is string && isValidId(data.assetId)
          && data.assetName is string && data.assetName.size() > 0
          && data.userId is string && isValidId(data.userId)
          && data.userName is string && data.userName.size() > 0
          && data.checkoutDate is int
          && data.expectedReturnDate is int
          && data.status in ['active', 'completed'];
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      
      allow create: if isOwner(userId) 
          && isValidUser(incoming()) 
          && (incoming().email.lower() == 'bolajiogidan@gmail.com' ? incoming().role == 'admin' : incoming().role == 'student'); 
          
      allow update: if (isOwner(userId) || isAdmin()) 
          && isValidUser(incoming())
          && (isOwner(userId) && incoming().email.lower() != 'bolajiogidan@gmail.com' ? (incoming().role == existing().role) : true) 
          && (incoming().email == existing().email); // Email is immutable

      allow delete: if isAdmin();
    }

    match /assets/{assetId} {
      allow read: if isSignedIn();
      
      allow create: if isTechnician() 
          && isValidAsset(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
          
      allow update: if isTechnician() 
          && isValidAsset(incoming())
          && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt']) || incoming().updatedAt == request.time)
          && incoming().createdAt == existing().createdAt
          && (
            // Action: Update metadata
            (incoming().diff(existing()).affectedKeys().hasOnly(['name', 'category', 'serialNumber', 'location', 'description', 'updatedAt', 'threshold', 'imageUrl'])) ||
            // Action: Update status/quantity (Checkout/Return flow)
            (incoming().diff(existing()).affectedKeys().hasAll(['status', 'quantity', 'updatedAt']))
          );
          
      allow delete: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow read: if isOwner(resource.data.userId) || isTechnician();
      allow list: if isTechnician() || (isSignedIn() && resource.data.userId == request.auth.uid);
      
      allow create: if isTechnician() 
          && isValidTransaction(incoming())
          && exists(/databases/$(database)/documents/assets/$(incoming().assetId))
          && exists(/databases/$(database)/documents/users/$(incoming().userId));
          
      allow update: if isTechnician() 
          && isValidTransaction(incoming())
          && incoming().assetId == existing().assetId
          && incoming().userId == existing().userId
          && (
            // Action: Complete Transaction
            (existing().status == 'active' && incoming().status == 'completed' && incoming().diff(existing()).affectedKeys().hasOnly(['returnDate', 'status']))
            || (incoming().diff(existing()).affectedKeys().hasOnly(['expectedReturnDate', 'status', 'returnDate']))
          );

      allow delete: if isAdmin();
    }
  }
}
